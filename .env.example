# Postgres everywhere (Vercel serverless cannot use SQLite).
# Local: use a free Neon branch, Docker Postgres, or Supabase.
# On Vercel/Supabase: DATABASE_URL = pooled Prisma URL; DIRECT_URL = non-pooling.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

SESSION_SECRET="generate-a-long-random-string"
ADMIN_EMAIL="joe@example.com"
NEXT_PUBLIC_APP_NAME="Family Vacation 2027"
