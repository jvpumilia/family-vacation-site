# SQLite demo (default — works with zero setup)
DATABASE_URL="file:../data/dev.db"

# For production Postgres / Supabase, swap to:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"
# and change prisma/schema.prisma provider to "postgresql"

SESSION_SECRET="generate-a-long-random-string"
ADMIN_EMAIL="your-email@example.com"
NEXT_PUBLIC_APP_NAME="Family Vacation 2027"

# Optional Supabase (not required for demo mode)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
